rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public content may be read by clients. All direct client writes are denied.
    // Server-side Admin SDK writes bypass these rules and require IAM credentials.
    match /{document=**} {
      allow read, write: if false;
    }
    match /news/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /opinions/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /events/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /directory/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /emergency/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /notices/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /lpgDeliveries/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /autos/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /destinations/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /cultures/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /stays/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /travelogues/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /photos/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /busRoutes/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /routes/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /metadata/{document} {
      allow read: if true;
      allow write: if false;
    }
    // Lost/found records are accessed via server APIs, never directly from clients.
    match /lostFound/{document} {
      allow read, write: if false;
    }
  }
}
